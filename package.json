{
  "name": "lemon-core",
  "version": "4.3.0",
  "description": "Lemon Serverless Micro-Service Platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/common/test-helper.d.ts",
      "import": "./dist/esm/testing.mjs",
      "require": "./dist/common/test-helper.js",
      "default": "./dist/common/test-helper.js"
    },
    "./dist/environ": {
      "types": "./dist/environ.d.ts",
      "import": "./dist/environ.js",
      "require": "./dist/environ.js",
      "default": "./dist/environ.js"
    },
    "./dist/cores/lambda/lambda-web-handler": {
      "types": "./dist/cores/lambda/lambda-web-handler.d.ts",
      "import": "./dist/cores/lambda/lambda-web-handler.js",
      "require": "./dist/cores/lambda/lambda-web-handler.js",
      "default": "./dist/cores/lambda/lambda-web-handler.js"
    },
    "./dist/extended/cores": {
      "types": "./dist/extended/cores/index.d.ts",
      "import": "./dist/extended/cores/index.js",
      "require": "./dist/extended/cores/index.js",
      "default": "./dist/extended/cores/index.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run fields:gen && npm run build-ts && node scripts/gen-esm-wrapper.cjs",
    "build-ts": "tsc -v && tsc",
    "!v5": "------- v5 packaging gates -----",
    "esm:smoke": "LS=1 node scripts/esm-smoke.mjs",
    "api:names": "node scripts/api-names.cjs --out -",
    "api:check": "node scripts/api-check.cjs",
    "fields:migrate": "lemon-fields migrate --report --update-tsconfig",
    "fields:gen": "lemon-fields gen --report",
    "fields:check": "lemon-fields --check",
    "fields:guard-common": "lemon-fields guard-common --report",
    "watch-ts": "tsc -w",
    "doc": "npm run doc:html && open dist/docs/index.html",
    "doc:html": "typedoc src/ --exclude **/*.spec.ts --out dist/docs",
    "doc:publish": "npm run doc:html && gh-pages -m \"docs(gh-pages): publish gh-pages via typedoc\" -d dist/docs",
    "lint": "tsc --noEmit && eslint '*/**/*.{js,ts,jsx,tsx}' --fix",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.js\"",
    "!test": "------- run self-test with vitest -----",
    "test": "LS=1 vitest run",
    "test.lemon": "ENV=lemon npm run test",
    "test:dev": "LS=1 vitest",
    "!test:watch": "---- custom test with profile -----",
    "test:watch": "lemon-fields guard-common && LS=1 vitest",
    "test:watch.lemon": "ENV=lemon npm run test:watch",
    "!prepare": "------- run self-test with vitest -----",
    "prepare": "npm run build",
    "!prepublishOnly": "npm test && npm run lint && npm run format",
    "#prepublishOnly": "npm test && npm run lint",
    "!plato": "----- analysis code complexity -----",
    "plato": "plato -r -d complexity dist"
  },
  "husky": {
    "hooks": {
      "!pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,ts,tsx,jsx}": [
      "npm run lint",
      "git add"
    ]
  },
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "author": "Steve Jung <steve@lemoncloud.io>",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.971.0",
    "@aws-sdk/client-dynamodb-streams": "^3.971.0",
    "@aws-sdk/client-iam": "^3.971.0",
    "@aws-sdk/client-kms": "^3.971.0",
    "@aws-sdk/client-lambda": "^3.971.0",
    "@aws-sdk/client-s3": "^3.971.0",
    "@aws-sdk/client-sns": "^3.971.0",
    "@aws-sdk/client-sqs": "^3.971.0",
    "@aws-sdk/client-sts": "^3.971.0",
    "@aws-sdk/credential-providers": "^3.971.0",
    "@aws-sdk/lib-dynamodb": "^3.971.0",
    "@opensearch-project/opensearch": "^3.9.0",
    "@types/aws-lambda": "^8.10.62",
    "@types/jsonwebtoken": "^8.5.9",
    "async": "^3.2.4",
    "crypto-js": "^4.2.0",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "lemon-model": "^1.1.1",
    "mime-types": "^3.0.2",
    "node-cache": "^5.1.2",
    "qs": "^6.15.1",
    "query-string": "^7.1.3",
    "source-map-support": "^0.5.21",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@aws-sdk/types": "^3.972.0",
    "@smithy/util-stream": "^3.3.4",
    "@types/async": "^3.2.15",
    "@types/crypto-js": "^4.2.2",
    "@types/js-yaml": "^3.12.5",
    "@types/mime-types": "^2.1.0",
    "@types/node": "^24.12.2",
    "@types/qs": "^6.14.0",
    "@types/supertest": "^2.0.10",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^5.15.0",
    "@typescript-eslint/parser": "^5.15.0",
    "@vitest/coverage-v8": "^4.1.4",
    "codecov": "^3.7.2",
    "concurrently": "^5.3.0",
    "dotenv": "^8.2.0",
    "eslint": "^8.23.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "faker": "^4.1.0",
    "gh-pages": "^5.0.0",
    "husky": "^8.0.3",
    "lemon-devkit": "^0.0.11",
    "lint-staged": "^13.1.0",
    "prettier": "^2.7.1",
    "superagent": "^5.3.1",
    "supertest": "^4.0.2",
    "ts-node": "^8.10.2",
    "typedoc": "^0.28.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/lemoncloud-io/lemon-core.git"
  },
  "keywords": [
    "lemoncloud",
    "lemon-core",
    "serverless"
  ],
  "bugs": {
    "url": "https://github.com/lemoncloud-io/lemon-core/issues"
  },
  "homepage": "https://github.com/lemoncloud-io/lemon-core#readme"
}
