{
  "name": "lemon-core",
  "version": "5.0.5",
  "description": "Lemon Serverless Micro-Service Platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "lemon-fields-types": "bin/lemon-fields-types.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/common/test-helper.d.ts",
      "import": "./dist/esm/testing.mjs",
      "require": "./dist/common/test-helper.js",
      "default": "./dist/common/test-helper.js"
    },
    "./dist/environ": {
      "types": "./dist/environ.d.ts",
      "import": "./dist/environ.js",
      "require": "./dist/environ.js",
      "default": "./dist/environ.js"
    },
    "./dist/cores/lambda/lambda-web-handler": {
      "types": "./dist/cores/lambda/lambda-web-handler.d.ts",
      "import": "./dist/cores/lambda/lambda-web-handler.js",
      "require": "./dist/cores/lambda/lambda-web-handler.js",
      "default": "./dist/cores/lambda/lambda-web-handler.js"
    },
    "./dist/extended/cores": {
      "types": "./dist/extended/cores/index.d.ts",
      "import": "./dist/extended/cores/index.js",
      "require": "./dist/extended/cores/index.js",
      "default": "./dist/extended/cores/index.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run build-ts && node scripts/gen-esm-wrapper.cjs",
    "build-ts": "tsc -v && tsc",
    "!v5": "------- v5 packaging gates -----",
    "esm:smoke": "LS=1 node scripts/esm-smoke.mjs",
    "api:names": "node scripts/api-names.cjs --out -",
    "api:check": "node scripts/api-check.cjs",
    "dup:check": "node scripts/dup-decls.cjs",
    "l1l2:probe": "node scripts/l1l2-probe.cjs",
    "fields:types": "node bin/lemon-fields-types.mjs",
    "watch-ts": "tsc -w",
    "lint": "tsc --noEmit && eslint '*/**/*.{js,ts,jsx,tsx}' --fix",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.js\"",
    "!test": "------- run self-test with vitest -----",
    "test": "LS=1 vitest run",
    "test.lemon": "ENV=lemon npm run test",
    "test:dev": "LS=1 vitest",
    "!test:watch": "---- custom test with profile -----",
    "test:watch": "LS=1 vitest",
    "test:watch.lemon": "ENV=lemon npm run test:watch",
    "!prepare": "------- run self-test with vitest -----",
    "prepare": "npm run build",
    "!prepublishOnly": "npm test && npm run lint && npm run format",
    "#prepublishOnly": "npm test && npm run lint",
    "!plato": "----- analysis code complexity -----",
    "plato": "plato -r -d complexity dist"
  },
  "husky": {
    "hooks": {
      "!pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,ts,tsx,jsx}": [
      "npm run lint",
      "git add"
    ]
  },
  "files": [
    "dist/**/*",
    "bin/lemon-fields-types.mjs",
    "bin/lib/fields-types.mjs"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "author": "Steve Jung <steve@lemoncloud.io>",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1159.0",
    "@aws-sdk/lib-dynamodb": "^3.1159.0",
    "@opensearch-project/opensearch": "^3.9.0",
    "@smithy/signature-v4": "^5.3.8",
    "@types/aws-lambda": "^8.10.62",
    "@types/jsonwebtoken": "^8.5.9",
    "async": "^3.2.4",
    "crypto-js": "^4.2.0",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "lemon-model": "^5.0.1",
    "mime-types": "^3.0.2",
    "node-cache": "^5.1.2",
    "qs": "^6.16.2",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@aws-sdk/client-iam": "^3.1159.0",
    "@aws-sdk/client-kms": "^3.1159.0",
    "@aws-sdk/client-lambda": "^3.1159.0",
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/client-sns": "^3.1159.0",
    "@aws-sdk/client-sqs": "^3.1159.0",
    "@aws-sdk/client-sts": "^3.1159.0",
    "@aws-sdk/credential-providers": "^3.1159.0",
    "@types/async": "^3.2.15",
    "@types/crypto-js": "^4.2.2",
    "@types/js-yaml": "^3.12.5",
    "@types/mime-types": "^2.1.0",
    "@types/node": "^24.12.2",
    "@types/qs": "^6.14.0",
    "@types/supertest": "^2.0.10",
    "@typescript-eslint/eslint-plugin": "^5.15.0",
    "@typescript-eslint/parser": "^5.15.0",
    "@vitest/coverage-v8": "^4.1.4",
    "concurrently": "^5.3.0",
    "eslint": "^8.23.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "faker": "^4.1.0",
    "lemon-devkit": "^0.2.1",
    "lint-staged": "^13.1.0",
    "prettier": "^2.7.1",
    "supertest": "^7.3.1",
    "ts-node": "^8.10.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "@aws-sdk/client-iam": "^3.1159.0",
    "@aws-sdk/client-kms": "^3.1159.0",
    "@aws-sdk/client-lambda": "^3.1159.0",
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/client-sns": "^3.1159.0",
    "@aws-sdk/client-sqs": "^3.1159.0",
    "@aws-sdk/client-sts": "^3.1159.0",
    "@aws-sdk/credential-providers": "^3.1159.0",
    "typescript": ">=4.7"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-iam": {
      "optional": true
    },
    "@aws-sdk/client-kms": {
      "optional": true
    },
    "@aws-sdk/client-lambda": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/client-sns": {
      "optional": true
    },
    "@aws-sdk/client-sqs": {
      "optional": true
    },
    "@aws-sdk/client-sts": {
      "optional": true
    },
    "@aws-sdk/credential-providers": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/lemoncloud-io/lemon-core.git"
  },
  "keywords": [
    "lemoncloud",
    "lemon-core",
    "serverless"
  ],
  "bugs": {
    "url": "https://github.com/lemoncloud-io/lemon-core/issues"
  },
  "homepage": "https://github.com/lemoncloud-io/lemon-core#readme"
}
